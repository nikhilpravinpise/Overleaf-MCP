{
  "version": 2,
  "builds": [
    {
      "src": "overleaf-mcp-server/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/mcp",
      "dest": "overleaf-mcp-server/api/index.js"
    },
    {
      "src": "/sse", 
      "dest": "overleaf-mcp-server/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "overleaf-mcp-server/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
