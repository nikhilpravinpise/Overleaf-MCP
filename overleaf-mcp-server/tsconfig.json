{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist",
        "rootDir": ".",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "types": [
            "node"
        ],
        "noImplicitAny": false,
        "strictNullChecks": false
    },
    "include": [
        "index.ts",
        "lib/**/*.ts",
        "tools/**/*.ts",
        "prompts/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "resources"
    ]
}