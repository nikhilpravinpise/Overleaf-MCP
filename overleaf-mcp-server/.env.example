# ============================================
# Overleaf MCP Server - Environment Configuration
# ============================================

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# ============================================
# OAuth 2.1 Authentication
# ============================================

# Enable OAuth (set to 'true' for production)
OAUTH_ENABLED=false

# Issuer URL (your deployed server URL)
OAUTH_ISSUER=https://your-server.mcp-use.cloud

# JWT signing secret (MUST be a secure 64+ char random string in production)
OAUTH_JWT_SECRET=generate-secure-64-character-random-string-here

# Token lifetimes (seconds)
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=604800
OAUTH_CODE_TTL=600

# OAuth data storage directory
OAUTH_DATA_DIR=./data/oauth

# Pre-configured admin user (optional)
OAUTH_ADMIN_EMAIL=
OAUTH_ADMIN_PASSWORD=

# ============================================
# Rate Limiting & Security
# ============================================

# API key for simple auth (optional, OAuth preferred)
MCP_REQUIRE_AUTH=false
MCP_API_KEY=

# Rate limiting (requests per minute per IP)
MCP_RATE_LIMIT=60

# Logging
MCP_ENABLE_LOGGING=true
MCP_LOG_LEVEL=info

# CORS (comma-separated origins, or '*' for all)
MCP_CORS_ORIGINS=*

# ============================================
# Compilation Settings
# ============================================

MCP_PRIVACY_MODE=ask
MCP_WARN_SIZE=5242880
MCP_DEFAULT_ENGINE=pdflatex
MCP_COMPILE_TIMEOUT=60000

# ============================================
# Overleaf Git Integration
# ============================================

# Git authentication token for seamless Overleaf sync
# Get this from: https://www.overleaf.com/user/settings
# Required for latex_clone_from_overleaf, latex_pull_from_overleaf, latex_push_to_overleaf
OVERLEAF_GIT_TOKEN=

# Overleaf session cookie for web API access (alternative to Git)
# Get this from browser DevTools (F12 → Network → filter /project → copy Cookie header)
# Format: overleaf_session2=... or sharelatex.sid=...
# Required for latex_download_from_overleaf (free accounts without Git integration)
OVERLEAF_SESSION_COOKIE=
