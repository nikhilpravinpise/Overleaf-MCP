{
  "name": "overleaf-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for seamless Overleaf integration with download/upload capabilities",
  "author": "Nikhil",
  "license": "MIT",
  "keywords": [
    "overleaf",
    "mcp",
    "latex",
    "collaboration",
    "download",
    "upload",
    "browser-automation"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:verify",
    "build:verify": "node -e \"console.log('✓ Build verification passed');\"",
    "dev": "tsx watch index.ts --clear-screen=false",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Add your preferred linter here'",
    "test": "echo 'Add your preferred test runner here'",
    "smart-auth": "tsx scripts/smart-auth.ts"
  },
  "dependencies": {
    "@openai/apps-sdk-ui": "^0.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.90.12",
    "@vitejs/plugin-react": "^6.0.1",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "mcp-use": "latest",
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.10.1",
    "simple-git": "^3.35.2",
    "tailwindcss": "^4.1.18",
    "vite": "^8.0.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25.0.3",
    "node-mocks-http": "^1.17.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sugarss": "^5.0.1"
  }
}
